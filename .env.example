# LLM Provider selection: ollama | groq | open_router | deepinfra | vllm
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter ---
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- DeepInfra ---
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- vLLM (local OpenAI-compatible server, see vllm/) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen3-32b
VLLM_API_KEY=EMPTY

# --- Embeddings (BGE-M3) ---
# HuggingFace model ID (default) or an absolute path to a local copy.
# Downloaded automatically from HF Hub on first startup.
BGE_M3_MODEL=BAAI/bge-m3

# Device for BGE-M3 inference: auto | cuda | mps | cpu
# "auto" detects CUDA first, then MPS (Apple Silicon), then falls back to CPU.
BGE_M3_DEVICE=auto

# --- Server ---
# Keep this off port 8000 if you run the local vLLM server (which uses 8000).
PORT=8001
