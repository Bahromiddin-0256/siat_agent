# Ollama Configuration
# Select provider: ollama, groq, open_router, deepinfra
LLM_PROVIDER=ollama

# Base URL for Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (default: llama3.2)
# Popular options: llama3.2, llama3.1, mistral, phi3, qwen2.5
OLLAMA_MODEL=llama3.2

# Ollama embedding model for RAG (default: nomic-embed-text)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# DeepInfra Configuration (OpenAI-compatible)
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
